<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Devoirs — GesPed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css?v=1">
    <link rel="stylesheet" href="/assets/css/components.css?v=1">
    <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body class="app-layout">
    <%- include('../includes/sidebar') %>
    <div class="main-content">
        <%- include('../includes/topbar') %>

        <div class="content-wrapper">
            <% if (msgSuccess) { %>
                <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= msgSuccess %>
                    <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            <% } %>
            <% if (msgError) { %>
                <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= msgError %>
                    <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            <% } %>

            <div class="welcome-banner">
                <div class="welcome-text">
                    <h2>Bienvenue, <%= nomComplet %> !</h2>
                    <p>Gérez les devoirs de vos modules.</p>
                </div>
                <i class="fas fa-tasks welcome-icon"></i>
            </div>

            <div class="page-header">
                <h3>Mes devoirs</h3>
                <a href="/professeur/devoir/ajouter" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nouveau devoir
                </a>
            </div>

            <% if (!devoirs || devoirs.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-tasks fa-3x"></i>
                    <p>Aucun devoir créé pour le moment.</p>
                    <a href="/professeur/devoir/ajouter" class="btn btn-primary">Créer un devoir</a>
                </div>
            <% } else { %>
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Module</th>
                                <th>Date limite</th>
                                <th>Soumissions</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% devoirs.forEach(function(d) { %>
                                <tr>
                                    <td><strong><%= d.titre %></strong></td>
                                    <td><%= d.module.codeModule %></td>
                                    <td>
                                        <% if (d.dateLimite) { %>
                                            <%= d.dateLimiteDate %> <small><%= d.dateLimiteTime %></small>
                                            <% if (d.depasse) { %><span class="badge badge-danger">Dépassé</span><% } %>
                                        <% } else { %>—<% } %>
                                    </td>
                                    <td><span class="badge badge-info"><%= d.nbSoumissions %></span></td>
                                    <td class="actions-cell">
                                        <a href="/professeur/devoir/voir?id=<%= d.idDevoir %>" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i> Détail
                                        </a>
                                        <a href="/professeur/devoir/supprimer?id=<%= d.idDevoir %>"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Supprimer ce devoir ?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
    <script src="/assets/js/main.js"></script>
</body>
</html>
