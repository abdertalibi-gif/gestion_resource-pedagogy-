<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Professeur — GesPed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css?v=1">
    <link rel="stylesheet" href="/assets/css/components.css?v=1">
    <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body class="app-layout">
    <%- include('../includes/sidebar') %>

    <div class="main-content">
        <%- include('../includes/topbar') %>

        <div class="content-wrapper">
            <% if (msgSuccess) { %><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= msgSuccess %><button class="alert-close" onclick="this.parentElement.remove()">&times;</button></div><% } %>
            <% if (msgError) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= msgError %><button class="alert-close" onclick="this.parentElement.remove()">&times;</button></div><% } %>

            <div class="welcome-banner">
                <div class="welcome-text"><h2>Bienvenue, <%= nomComplet %></h2><p>G&eacute;rez vos ressources p&eacute;dagogiques depuis cet espace.</p></div>
                <i class="fas fa-chalkboard-teacher welcome-icon"></i>
            </div>

            <div class="page-header"><h1>Tableau de bord</h1><p>Vue d'ensemble de votre espace</p></div>

            <% const filiereNames = [...new Set((modules || []).map(m => m.filiere && m.filiere.nomFiliere).filter(Boolean))]; %>
            <div class="stats-cards">
                <div class="stat-card-dashboard grad-deep"><div class="stat-card-icon"><i class="fas fa-book"></i></div><div class="stat-card-info"><span class="stat-card-number"><%= modules.length %></span><span class="stat-card-label">Modules</span></div></div>
                <div class="stat-card-dashboard grad-mid"><div class="stat-card-icon"><i class="fas fa-file-alt"></i></div><div class="stat-card-info"><span class="stat-card-number"><%= nbRessources %></span><span class="stat-card-label">Ressources</span></div></div>
                <div class="stat-card-dashboard grad-bright"><div class="stat-card-icon"><i class="fas fa-graduation-cap"></i></div><div class="stat-card-info"><span class="stat-card-number" style="font-size:15px"><%= filiereNames.length > 0 ? filiereNames.join(', ') : '—' %></span><span class="stat-card-label">Fili&egrave;re</span></div></div>
            </div>

            <div class="dashboard-section">
                <div class="section-header">
                    <h3><i class="fas fa-bolt"></i> Actions rapides</h3>
                </div>
                <div class="quick-actions">
                    <a href="/professeur/ressource/ajouter" class="btn btn-primary">
                        <i class="fas fa-plus"></i> D&eacute;poser une ressource
                    </a>
                    <a href="/professeur/ressources" class="btn btn-outline">
                        <i class="fas fa-list"></i> Voir mes ressources
                    </a>
                </div>
            </div>

            <% if (dernieresRessources && dernieresRessources.length > 0) { %>
                <div class="dashboard-section">
                    <div class="section-header">
                        <h3><i class="fas fa-clock"></i> Mes dernières ressources</h3>
                        <a href="/professeur/ressources" class="btn btn-sm btn-outline">Tout voir</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Titre</th><th>Type</th><th>Module</th><th>Taille</th><th>Statut</th></tr></thead>
                            <tbody>
                                <% dernieresRessources.forEach(function(r) { %>
                                    <tr>
                                        <td><div class="table-file"><i class="fas <%= r.iconeType %>" style="color:<%= r.couleurType %>"></i><span><%= r.titre %></span></div></td>
                                        <td><span class="badge" style="background:<%= r.couleurType %>"><%= r.type.nomType %></span></td>
                                        <td><%= r.module.nomModule %></td>
                                        <td><%= r.tailleFormatee %></td>
                                        <td><span class="status-badge <%= r.visible ? 'status-active' : 'status-inactive' %>"><%= r.visible ? 'Visible' : 'Masquée' %></span></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
    <script>const s=document.getElementById('sidebarToggle'),b=document.getElementById('sidebar'),o=document.getElementById('sidebarOverlay');if(s)s.addEventListener('click',function(){b.classList.toggle('open');o.classList.toggle('open')});if(o)o.addEventListener('click',function(){b.classList.remove('open');o.classList.remove('open')})</script>
</body>
</html>
