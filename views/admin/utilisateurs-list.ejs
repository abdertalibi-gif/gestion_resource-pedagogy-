<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Utilisateurs — GesPed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css?v=1">
    <link rel="stylesheet" href="/assets/css/components.css?v=1">
    <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body class="app-layout">
    <%- include('../includes/sidebar') %>
    <div class="main-content">
        <%- include('../includes/topbar') %>

        <div class="content-wrapper">
            <% if (msgSuccess) { %>
                <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= msgSuccess %>
                    <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            <% } %>
            <% if (msgError) { %>
                <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= msgError %>
                    <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            <% } %>

            <div class="welcome-banner">
                <div class="welcome-text">
                    <h2>Bienvenue, <%= nomComplet %> !</h2>
                    <p>Gérez tous les utilisateurs de la plateforme.</p>
                </div>
                <i class="fas fa-users-cog welcome-icon"></i>
            </div>

            <div class="page-header">
                <h3>Tous les utilisateurs</h3>
                <a href="/admin/utilisateur/ajouter" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Ajouter un utilisateur
                </a>
            </div>

            <div class="filter-bar">
                <form method="get" class="filter-form">
                    <select name="role" onchange="this.form.submit()" class="form-select">
                        <option value="">Tous les rôles</option>
                        <option value="ADMIN" <%= roleFilter === 'ADMIN' ? 'selected' : '' %>>Administrateurs</option>
                        <option value="PROFESSEUR" <%= roleFilter === 'PROFESSEUR' ? 'selected' : '' %>>Professeurs</option>
                        <option value="ETUDIANT" <%= roleFilter === 'ETUDIANT' ? 'selected' : '' %>>Étudiants</option>
                    </select>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Nom complet</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>CNE</th>
                            <th>Rôle</th>
                            <th>Filière</th>
                            <th>Semestre</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (utilisateurs && utilisateurs.length > 0) { %>
                            <% utilisateurs.forEach(function(u) { %>
                                <tr>
                                    <td>
                                        <div class="table-user">
                                            <div class="table-avatar"><i class="fas fa-user"></i></div>
                                            <div>
                                                <strong><%= u.nomComplet %></strong>
                                                <small><%= u.dateCreation ? u.dateCreation.substring(0, 10) : '' %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><%= u.email %></td>
                                    <td><%= u.telephone || '-' %></td>
                                    <td><%= u.cne || '-' %></td>
                                    <td>
                                        <span class="badge badge-<%= u.role.nomRole.toLowerCase() %>">
                                            <%= u.role.nomRole %>
                                        </span>
                                    </td>
                                    <td><%= u.filiere ? u.filiere.nomFiliere : '-' %></td>
                                    <td><%= u.semestre ? u.semestre.nomSemestre : '-' %></td>
                                    <td>
                                        <span class="status-badge <%= u.statut === 'ACCEPTE' ? 'status-active' : u.statut === 'EN_ATTENTE' ? 'status-pending' : 'status-inactive' %>">
                                            <%= u.statutLabel %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="table-actions">
                                            <a href="/admin/utilisateur/modifier?id=<%= u.idUtilisateur %>"
                                               class="btn-action btn-edit" title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <% if (u.statut === 'ACCEPTE') { %>
                                                <a href="/admin/utilisateur/toggle?id=<%= u.idUtilisateur %>"
                                                   class="btn-action btn-warning" title="Désactiver"
                                                   onclick="return confirm('Confirmer ?')">
                                                    <i class="fas fa-ban"></i>
                                                </a>
                                            <% } else if (u.statut === 'REFUSE') { %>
                                                <a href="/admin/utilisateur/toggle?id=<%= u.idUtilisateur %>"
                                                   class="btn-action btn-success" title="Réactiver"
                                                   onclick="return confirm('Réactiver ce compte ?')">
                                                    <i class="fas fa-check"></i>
                                                </a>
                                            <% } %>
                                            <% if (u.statut === 'EN_ATTENTE') { %>
                                                <a href="/admin/utilisateur/accepter?id=<%= u.idUtilisateur %>"
                                                   class="btn-action btn-success" title="Accepter">
                                                    <i class="fas fa-check"></i>
                                                </a>
                                                <a href="/admin/utilisateur/refuser?id=<%= u.idUtilisateur %>"
                                                   class="btn-action btn-danger" title="Refuser">
                                                    <i class="fas fa-times"></i>
                                                </a>
                                            <% } %>
                                            <a href="/admin/utilisateur/supprimer?id=<%= u.idUtilisateur %>"
                                               class="btn-action btn-delete" title="Supprimer"
                                               onclick="return confirm('Supprimer cet utilisateur ? Cette action est irréversible.')">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="9" class="text-center text-muted">Aucun utilisateur trouvé</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/dashboard.js"></script>
</body>
</html>
