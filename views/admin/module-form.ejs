<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> — GesPed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css?v=1">
    <link rel="stylesheet" href="/assets/css/components.css?v=1">
    <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body class="app-layout">
    <%- include('../includes/sidebar') %>
    <div class="main-content">
        <%- include('../includes/topbar') %>
        <div class="content-wrapper">
            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <ul><% errors.forEach(function(err) { %><li><%= err %></li><% }); %></ul>
                </div>
            <% } %>

            <div class="welcome-banner">
                <div class="welcome-text">
                    <h2>Bienvenue, <%= nomComplet %> !</h2>
                    <p>Créez ou modifiez un module.</p>
                </div>
                <i class="fas fa-book welcome-icon"></i>
            </div>

            <div class="form-card">
                <div class="form-card-header">
                    <h3><%= editMode ? 'Modifier le module' : 'Nouveau module' %></h3>
                    <a href="/admin/modules" class="btn btn-outline btn-sm">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
                <form method="post"
                      action="/admin/module/<%= editMode ? 'modifier' : 'ajouter' %>"
                      class="form-grid">
                    <% if (editMode && moduleItem) { %>
                        <input type="hidden" name="id" value="<%= moduleItem.idModule %>">
                    <% } %>
                    <div class="form-group">
                        <label for="codeModule">Code module <span class="required">*</span></label>
                        <input type="text" id="codeModule" name="codeModule" value="<%= moduleItem?.codeModule || '' %>"
                               required placeholder="Ex: BDD-S5">
                    </div>
                    <div class="form-group">
                        <label for="nomModule">Nom du module <span class="required">*</span></label>
                        <input type="text" id="nomModule" name="nomModule" value="<%= moduleItem?.nomModule || '' %>"
                               required placeholder="Ex: Base de données">
                    </div>
                    <div class="form-group">
                        <label for="idFiliere">Filière <span class="required">*</span></label>
                        <select id="idFiliere" name="idFiliere" required class="form-select">
                            <option value="">-- Sélectionner --</option>
                            <% filieres.forEach(function(f) { %>
                                <option value="<%= f.idFiliere %>"
                                    <%= moduleItem?.filiere && moduleItem.filiere.idFiliere === f.idFiliere ? 'selected' : '' %>>
                                    <%= f.nomFiliere %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="idSemestre">Semestre <span class="required">*</span></label>
                        <select id="idSemestre" name="idSemestre" required class="form-select">
                            <option value="">-- Sélectionner --</option>
                            <% semestres.forEach(function(s) { %>
                                <option value="<%= s.idSemestre %>"
                                    <%= moduleItem?.semestre && moduleItem.semestre.idSemestre === s.idSemestre ? 'selected' : '' %>>
                                    <%= s.nomSemestre %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="3"
                                  placeholder="Description optionnelle"><%= moduleItem?.description || '' %></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> <%= editMode ? 'Modifier' : 'Créer' %>
                        </button>
                        <a href="/admin/modules" class="btn btn-outline">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="/assets/js/main.js"></script>
</body>
</html>
