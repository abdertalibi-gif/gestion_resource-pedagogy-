<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> — GesPed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css?v=1">
    <link rel="stylesheet" href="/assets/css/components.css?v=1">
    <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body class="app-layout">
    <%- include('../includes/sidebar') %>
    <div class="main-content">
        <%- include('../includes/topbar') %>

        <div class="content-wrapper">
            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <ul>
                        <% errors.forEach(function(err) { %>
                            <li><%= err %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <div class="welcome-banner">
                <div class="welcome-text">
                    <h2>Bienvenue, <%= nomComplet %> !</h2>
                    <p>Créez ou modifiez un utilisateur.</p>
                </div>
                <i class="fas fa-user-cog welcome-icon"></i>
            </div>

            <div class="form-card">
                <div class="form-card-header">
                    <h3><%= editMode ? "Modifier l'utilisateur" : 'Nouvel utilisateur' %></h3>
                    <a href="/admin/utilisateurs" class="btn btn-outline btn-sm">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>

                <form method="post"
                      action="/admin/utilisateur/<%= editMode ? 'modifier' : 'ajouter' %>"
                      class="form-grid" id="userForm">

                    <% if (editMode && utilisateurForm) { %>
                        <input type="hidden" name="id" value="<%= utilisateurForm.idUtilisateur %>">
                    <% } %>

                    <div class="form-group">
                        <label for="nom">Nom <span class="required">*</span></label>
                        <input type="text" id="nom" name="nom" value="<%= utilisateurForm?.nom || '' %>" required placeholder="Nom de famille">
                    </div>

                    <div class="form-group">
                        <label for="prenom">Prénom <span class="required">*</span></label>
                        <input type="text" id="prenom" name="prenom" value="<%= utilisateurForm?.prenom || '' %>" required placeholder="Prénom">
                    </div>

                    <div class="form-group">
                        <label for="email">Email <span class="required">*</span></label>
                        <input type="email" id="email" name="email" value="<%= utilisateurForm?.email || '' %>" required placeholder="email@exemple.com">
                    </div>

                    <div class="form-group">
                        <label for="telephone">Téléphone</label>
                        <input type="tel" id="telephone" name="telephone" value="<%= utilisateurForm?.telephone || '' %>" placeholder="0600000000">
                    </div>

                    <div class="form-group" id="cneGroup" style="display:none">
                        <label for="cne">CNE <span class="required">*</span></label>
                        <input type="text" id="cne" name="cne" value="<%= utilisateurForm?.cne || '' %>" placeholder="Ex: E123456789">
                    </div>

                    <% if (!editMode) { %>
                        <div class="form-group">
                            <label for="motDePasse">Mot de passe <span class="required">*</span></label>
                            <input type="password" id="motDePasse" name="motDePasse" required placeholder="Minimum 6 caractères" minlength="6">
                        </div>
                    <% } %>

                    <div class="form-group">
                        <label for="role">Rôle <span class="required">*</span></label>
                        <select id="role" name="role" required class="form-select">
                            <option value="">-- Sélectionner un rôle --</option>
                            <option value="ADMIN" <%= utilisateurForm?.role?.nomRole === 'ADMIN' ? 'selected' : '' %>>Administrateur</option>
                            <option value="PROFESSEUR" <%= utilisateurForm?.role?.nomRole === 'PROFESSEUR' ? 'selected' : '' %>>Professeur</option>
                            <option value="ETUDIANT" <%= utilisateurForm?.role?.nomRole === 'ETUDIANT' ? 'selected' : '' %>>Étudiant</option>
                        </select>
                    </div>

                    <div class="form-group" id="filiereGroup" style="display:none">
                        <label for="idFiliere">Filière</label>
                        <select id="idFiliere" name="idFiliere" class="form-select">
                            <option value="">-- Sélectionner --</option>
                            <% filieres.forEach(function(f) { %>
                                <option value="<%= f.idFiliere %>"
                                    <%= utilisateurForm?.filiere && utilisateurForm.filiere.idFiliere === f.idFiliere ? 'selected' : '' %>>
                                    <%= f.nomFiliere %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group" id="semestreGroup" style="display:none">
                        <label for="idSemestre">Semestre</label>
                        <select id="idSemestre" name="idSemestre" class="form-select">
                            <option value="">-- Sélectionner --</option>
                            <% semestres.forEach(function(s) { %>
                                <option value="<%= s.idSemestre %>"
                                    <%= utilisateurForm?.semestre && utilisateurForm.semestre.idSemestre === s.idSemestre ? 'selected' : '' %>>
                                    <%= s.nomSemestre %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> <%= editMode ? 'Modifier' : 'Créer' %>
                        </button>
                        <a href="/admin/utilisateurs" class="btn btn-outline">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/assets/js/main.js"></script>
    <script>
        const roleSelect = document.getElementById('role');
        const filiereGroup = document.getElementById('filiereGroup');
        const semestreGroup = document.getElementById('semestreGroup');
        const cneGroup = document.getElementById('cneGroup');

        function toggleFields() {
            const isEtudiant = roleSelect.value === 'ETUDIANT';
            filiereGroup.style.display = isEtudiant ? '' : 'none';
            semestreGroup.style.display = isEtudiant ? '' : 'none';
            cneGroup.style.display = isEtudiant ? '' : 'none';
        }

        roleSelect.addEventListener('change', toggleFields);
        toggleFields();
    </script>
</body>
</html>
