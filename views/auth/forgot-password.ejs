<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mot de passe oublié — GesPed</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css?v=1">
  <link rel="stylesheet" href="/assets/css/components.css?v=1">
  <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="logo-left">
        <a href="/" title="Accueil">
          <img src="/logofsm.jpg" alt="Université Moulay Ismail — Faculté des Sciences">
        </a>
      </div>
      <a href="/" class="logo-right" title="GesPed">
        <div class="gesped-icon"><i class="fas fa-graduation-cap"></i></div>
        <div class="gesped-text">
          <strong>GesPed</strong>
          <small class="text-warning">Gestion Pédagogique</small>
        </div>
      </a>
    </div>
  </header>

  <div class="page-wrap">
    <div class="side-blue">
      <div class="deco-formulas">
        <div>(1+x+y+2a)·(3a+3g)</div>
        <div>&int;&#8320;^&infin; e^(-t&sup2;) dt = &radic;&pi;/2</div>
        <div>&sum; x&#7522;&sup2; = &Vert;x&Vert;&sup2; cos(&theta;)</div>
        <div>&nabla;f = (&part;f/&part;x, &part;f/&part;y)</div>
        <div>y = ax&sup2; + bx + c</div>
      </div>
      <div class="deco-num">?</div>

      <div class="blue-content">
        <div class="blue-avatar"><i class="fas fa-key"></i></div>
        <h2>Mot de passe<br>oubli&eacute; ?</h2>
        <div class="orange-bar"></div>
        <p>Pas d'inqui&eacute;tude, r&eacute;initialiser votre acc&egrave;s est simple et rapide.</p>

        <% if (verified) { %>
          <div class="blue-steps">
            <div class="bs done">
              <div class="bs-num"><i class="fas fa-check"></i></div>
              <div class="bs-text">Identit&eacute; v&eacute;rifi&eacute;e — <strong><%= userName %></strong></div>
            </div>
            <div class="bs active">
              <div class="bs-num">2</div>
              <div class="bs-text">D&eacute;finissez votre nouveau mot de passe</div>
            </div>
            <div class="bs">
              <div class="bs-num">3</div>
              <div class="bs-text">Reconnectez-vous &agrave; votre espace GesPed</div>
            </div>
          </div>
        <% } else { %>
          <div class="blue-steps">
            <div class="bs active">
              <div class="bs-num">1</div>
              <div class="bs-text">V&eacute;rifiez votre identit&eacute; (email + identit&eacute;)</div>
            </div>
            <div class="bs">
              <div class="bs-num">2</div>
              <div class="bs-text">D&eacute;finissez votre nouveau mot de passe</div>
            </div>
            <div class="bs">
              <div class="bs-num">3</div>
              <div class="bs-text">Reconnectez-vous &agrave; votre espace GesPed</div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="side-white">
      <div class="form-box">
        <div class="form-eyebrow"><i class="fas fa-key"></i> R&eacute;cup&eacute;ration</div>

        <% if (verified) { %>
          <h1 class="form-title">Nouveau mot de passe</h1>
          <p class="form-subtitle">
            Bonjour <strong><%= userName %></strong>, choisissez votre nouveau mot de passe.
          </p>

          <% if (error) { %>
            <div class="alert alert-err">
              <i class="fas fa-exclamation-circle"></i>
              <span><%= error %></span>
            </div>
          <% } %>

          <form id="resetForm" action="/forgot-password" method="post" autocomplete="off" novalidate>
            <input type="hidden" name="action" value="reset">
            <input type="hidden" name="userId" value="<%= userId %>">
            <input type="hidden" name="userName" value="<%= userName || '' %>">

            <div class="fgroup">
              <label class="flabel" for="password"><i class="fas fa-lock"></i> Nouveau mot de passe</label>
              <div class="finput-wrap">
                <i class="fas fa-lock finput-icon"></i>
                <input type="password" id="password" name="password" class="finput" placeholder="Au moins 6 caract&egrave;res" minlength="6" required>
              </div>
              <div class="field-error" id="pwError">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Minimum 6 caract&egrave;res.</span>
              </div>
            </div>

            <div class="fgroup">
              <label class="flabel" for="confirm"><i class="fas fa-check-circle"></i> Confirmer le mot de passe</label>
              <div class="finput-wrap">
                <i class="fas fa-check-circle finput-icon"></i>
                <input type="password" id="confirm" name="confirm" class="finput" placeholder="Retaper le mot de passe" required>
              </div>
              <div class="field-error" id="confirmError">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Les mots de passe ne correspondent pas.</span>
              </div>
            </div>

            <button type="submit" class="btn-submit" id="resetBtn">
              <span class="btn-icon"><i class="fas fa-save"></i></span>
              <span class="btn-text">R&eacute;initialiser</span>
              <span class="spinner"></span>
            </button>
          </form>
        <% } else { %>
          <h1 class="form-title">R&eacute;initialiser</h1>
          <p class="form-subtitle">
            Entrez votre adresse email ainsi que votre nom et pr&eacute;nom pour v&eacute;rifier votre identit&eacute;.
          </p>

          <% if (error) { %>
            <div class="alert alert-err">
              <i class="fas fa-exclamation-circle"></i>
              <span><%= error %></span>
            </div>
          <% } %>

          <form id="verifyForm" action="/forgot-password" method="post" autocomplete="on" novalidate>
            <div class="fgroup">
              <label class="flabel" for="email"><i class="fas fa-envelope"></i> Adresse email</label>
              <div class="finput-wrap">
                <i class="fas fa-envelope finput-icon"></i>
                <input type="email" id="email" name="email" class="finput" placeholder="votre.nom@univ.ma" autocomplete="email" required>
              </div>
              <div class="field-error" id="emailError">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Veuillez entrer une adresse email valide.</span>
              </div>
            </div>

            <div class="fgroup">
              <label class="flabel" for="nom"><i class="fas fa-user"></i> Nom</label>
              <div class="finput-wrap">
                <i class="fas fa-user finput-icon"></i>
                <input type="text" id="nom" name="nom" class="finput" placeholder="Votre nom de famille" autocomplete="family-name" required>
              </div>
              <div class="field-error" id="nomError">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Ce champ est obligatoire.</span>
              </div>
            </div>

            <div class="fgroup">
              <label class="flabel" for="prenom"><i class="fas fa-user"></i> Pr&eacute;nom</label>
              <div class="finput-wrap">
                <i class="fas fa-user finput-icon"></i>
                <input type="text" id="prenom" name="prenom" class="finput" placeholder="Votre pr&eacute;nom" autocomplete="given-name" required>
              </div>
              <div class="field-error" id="prenomError">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Ce champ est obligatoire.</span>
              </div>
            </div>

            <div class="fgroup">
              <label class="flabel" for="cne"><i class="fas fa-id-card"></i> CNE</label>
              <div class="finput-wrap">
                <i class="fas fa-id-card finput-icon"></i>
                <input type="text" id="cne" name="cne" class="finput" placeholder="Code National de l'&Eacute;tudiant" autocomplete="off">
              </div>
              <div class="field-error" id="cneError">
                <i class="fas fa-exclamation-triangle"></i>
                <span>CNE invalide.</span>
              </div>
            </div>

            <button type="submit" class="btn-submit" id="verifyBtn">
              <span class="btn-icon"><i class="fas fa-shield-alt"></i></span>
              <span class="btn-text">V&eacute;rifier mon identit&eacute;</span>
              <span class="spinner"></span>
            </button>
          </form>
        <% } %>

        <div class="divider">ou</div>

        <div class="form-links">
          <a href="/login"><i class="fas fa-arrow-left"></i> Retour &agrave; la connexion</a>
          <span class="dot">&middot;</span>
          <a href="/"><i class="fas fa-home"></i> Accueil</a>
        </div>

        <div class="secure">
          <i class="fas fa-shield-alt"></i>
          Demande s&eacute;curis&eacute;e — Universit&eacute; Moulay Ismail
        </div>
      </div>
    </div>
  </div>

  <footer class="foot">
    &copy; 2025 GesPed &mdash;
    <a href="https://fs-umi.ac.ma" target="_blank">Facult&eacute; des Sciences</a>
    &mdash; Universit&eacute; Moulay Ismail, Mekn&egrave;s
  </footer>

  <script>
    (function() {
      var verifyForm = document.getElementById('verifyForm');
      if (verifyForm) {
        var emailInput = document.getElementById('email');
        var nomInput = document.getElementById('nom');
        var prenomInput = document.getElementById('prenom');
        var cneInput = document.getElementById('cne');
        var emailError = document.getElementById('emailError');
        var nomError = document.getElementById('nomError');
        var prenomError = document.getElementById('prenomError');
        var cneError = document.getElementById('cneError');
        var verifyBtn = document.getElementById('verifyBtn');
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

        function clearError(input, errEl) { input.classList.remove('input-error'); errEl.classList.remove('show'); }
        function showError(input, errEl) { input.classList.add('input-error'); errEl.classList.add('show'); }

        emailInput.addEventListener('blur', function() {
          if (this.value.trim() !== '' && !emailRegex.test(this.value.trim())) showError(this, emailError);
          else clearError(this, emailError);
        });
        emailInput.addEventListener('input', function() { clearError(this, emailError); });
        nomInput.addEventListener('input', function() { clearError(this, nomError); });
        prenomInput.addEventListener('input', function() { clearError(this, prenomError); });
        cneInput.addEventListener('input', function() { clearError(this, cneError); });

        verifyForm.addEventListener('submit', function(e) {
          var ok = true;
          if (!nomInput.value.trim()) { showError(nomInput, nomError); ok = false; }
          if (!prenomInput.value.trim()) { showError(prenomInput, prenomError); ok = false; }
          var ev = emailInput.value.trim();
          if (!ev || !emailRegex.test(ev)) { showError(emailInput, emailError); ok = false; }
          if (cneInput.value.trim() && cneInput.value.trim().length < 4) { showError(cneInput, cneError); ok = false; }
          if (!ok) { e.preventDefault(); return; }
          verifyBtn.classList.add('loading');
          verifyBtn.disabled = true;
        });
      }

      var resetForm = document.getElementById('resetForm');
      if (resetForm) {
        var pwInput = document.getElementById('password');
        var confirmInput = document.getElementById('confirm');
        var pwError = document.getElementById('pwError');
        var confirmError = document.getElementById('confirmError');
        var resetBtn = document.getElementById('resetBtn');

        pwInput.addEventListener('input', function() { pwInput.classList.remove('input-error'); pwError.classList.remove('show'); });
        confirmInput.addEventListener('input', function() {
          confirmInput.classList.remove('input-error'); confirmError.classList.remove('show');
          if (this.value && pwInput.value && this.value !== pwInput.value) {
            confirmInput.classList.add('input-error');
            confirmError.classList.add('show');
          }
        });

        resetForm.addEventListener('submit', function(e) {
          var ok = true;
          if (pwInput.value.length < 6) { pwInput.classList.add('input-error'); pwError.classList.add('show'); ok = false; }
          if (pwInput.value !== confirmInput.value || !confirmInput.value) { confirmInput.classList.add('input-error'); confirmError.classList.add('show'); ok = false; }
          if (!ok) { e.preventDefault(); return; }
          resetBtn.classList.add('loading');
          resetBtn.disabled = true;
        });
      }
    })();
  </script>
</body>
</html>
