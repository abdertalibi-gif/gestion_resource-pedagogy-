<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes soumissions — GesPed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css?v=1">
    <link rel="stylesheet" href="/assets/css/components.css?v=1">
    <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body class="app-layout">
    <%- include('../includes/sidebar') %>
    <div class="main-content">
        <%- include('../includes/topbar') %>

        <div class="content-wrapper">
            <% if (msgSuccess) { %>
                <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= msgSuccess %>
                    <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            <% } %>
            <% if (msgError) { %>
                <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= msgError %>
                    <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            <% } %>

            <div class="welcome-banner">
                <div class="welcome-text">
                    <h2>Bienvenue, <%= nomComplet %> !</h2>
                    <p>Suivez l'&eacute;tat de vos soumissions.</p>
                </div>
                <i class="fas fa-check-double welcome-icon"></i>
            </div>

            <div class="page-header">
                <h3>Mes soumissions</h3>
                <a href="/etudiant/soumettre" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nouvelle soumission
                </a>
            </div>

            <% if (!soumissions || soumissions.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-inbox fa-3x"></i>
                    <p>Aucune soumission pour le moment.</p>
                    <a href="/etudiant/soumettre" class="btn btn-primary">Soumettre un devoir</a>
                </div>
            <% } else { %>
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Module</th>
                                <th>Fichier</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th>Note</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% soumissions.forEach(s => { %>
                                <tr>
                                    <td><strong><%= s.titre %></strong></td>
                                    <td><%= s.module.codeModule %></td>
                                    <td><%= s.nomFichier %> <small>(<%= s.tailleFormatee %>)</small></td>
                                    <td><%= s.dateSoumissionDate %> <small><%= s.dateSoumissionTime %></small></td>
                                    <td><span class="badge <%= s.statutBadge %>"><%= s.statutLabel %></span></td>
                                    <td>
                                        <% if (s.note !== null && s.note !== undefined) { %>
                                            <%= s.note %>/20
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/etudiant/soumission/telecharger?id=<%= s.idSoumission %>"
                                           class="btn btn-sm btn-outline" target="_blank">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/dashboard.js"></script>
</body>
</html>
