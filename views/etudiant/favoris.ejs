<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Favoris — GesPed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css?v=1">
    <link rel="stylesheet" href="/assets/css/components.css?v=1">
    <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body class="app-layout">
    <%- include('../includes/sidebar') %>
    <div class="main-content">
        <%- include('../includes/topbar') %>
        <div class="content-wrapper">
            <div class="welcome-banner">
                <div class="welcome-text">
                    <h2>Bienvenue, <%= nomComplet %> !</h2>
                    <p>Retrouvez vos ressources favorites.</p>
                </div>
                <i class="fas fa-star welcome-icon"></i>
            </div>

            <div class="page-header"><h3><i class="fas fa-star"></i> Mes favoris</h3></div>
            <div class="cards-grid">
                <% (favoris || []).forEach(fav => { %>
                    <div class="resource-card">
                        <div class="resource-card-icon" style="color:<%= fav.ressource.couleurType %>;background:<%= fav.ressource.couleurType %>15;">
                            <i class="fas <%= fav.ressource.iconeType %>"></i>
                        </div>
                        <div class="resource-card-body">
                            <h4><%= fav.ressource.titre %></h4>
                            <p class="resource-meta-text">
                                <%= fav.ressource.module.nomModule %> — Ajout&eacute; le <%= fav.dateAjout %>
                            </p>
                            <div class="resource-card-meta">
                                <span class="badge" style="background:<%= fav.ressource.couleurType %>"><%= fav.ressource.type.nomType %></span>
                            </div>
                        </div>
                        <div class="resource-card-actions">
                            <a href="/etudiant/ressource/voir?id=<%= fav.ressource.idRessource %>" class="btn-action btn-view"><i class="fas fa-eye"></i></a>
                            <a href="/etudiant/ressource/telecharger?id=<%= fav.ressource.idRessource %>" class="btn-action btn-download"><i class="fas fa-download"></i></a>
                            <a href="/etudiant/favori/retirer?id=<%= fav.ressource.idRessource %>" class="btn-action btn-fav-active" title="Retirer des favoris"><i class="fas fa-star"></i></a>
                        </div>
                    </div>
                <% }) %>
                <% if (!favoris || favoris.length === 0) { %>
                    <div class="empty-state" style="grid-column:1/-1;">
                        <i class="fas fa-star"></i><h4>Aucun favori</h4>
                        <p>Vous n'avez pas encore ajout&eacute; de ressources en favori</p>
                        <a href="/etudiant/ressources" class="btn btn-primary">Parcourir les ressources</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/dashboard.js"></script>
</body>
</html>
