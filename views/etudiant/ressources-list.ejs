<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ressources — GesPed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Raleway:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css?v=1">
    <link rel="stylesheet" href="/assets/css/components.css?v=1">
    <link rel="stylesheet" href="/assets/css/responsive.css?v=1">
</head>
<body class="app-layout">
    <%- include('../includes/sidebar') %>
    <div class="main-content">
        <%- include('../includes/topbar') %>

        <div class="content-wrapper">
            <% if (msgSuccess) { %>
                <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= msgSuccess %>
                    <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            <% } %>
            <% if (msgError) { %>
                <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= msgError %>
                    <button class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            <% } %>

            <div class="welcome-banner">
                <div class="welcome-text">
                    <h2>Bienvenue, <%= nomComplet %> !</h2>
                    <p>Retrouvez toutes les ressources p&eacute;dagogiques.</p>
                </div>
                <i class="fas fa-folder-open welcome-icon"></i>
            </div>

            <div class="page-header">
                <h3>Ressources p&eacute;dagogiques</h3>
                <a href="/etudiant/recherche" class="btn btn-outline">
                    <i class="fas fa-search"></i> Recherche avanc&eacute;e
                </a>
            </div>

            <div class="filter-bar">
                <div class="filter-chips">
                    <a href="/etudiant/ressources<%= moduleFilter ? '?module=' + moduleFilter : '' %>"
                       class="chip <%= !typeFilter ? 'chip-active' : '' %>">Tous</a>
                    <% (types || []).forEach(t => { %>
                        <a href="/etudiant/ressources?type=<%= encodeURIComponent(t.nomType) %><%= moduleFilter ? '&module=' + encodeURIComponent(moduleFilter) : '' %>"
                           class="chip <%= typeFilter === t.nomType ? 'chip-active' : '' %>">
                            <%= t.nomType %>
                        </a>
                    <% }) %>
                </div>
            </div>

            <div class="cards-grid">
                <% (ressources || []).forEach(r => { %>
                    <div class="resource-card">
                        <div class="resource-card-icon" style="color:<%= r.couleurType %>; background:<%= r.couleurType %>15;">
                            <i class="fas <%= r.iconeType %>"></i>
                        </div>
                        <div class="resource-card-body">
                            <h4><%= r.titre %></h4>
                            <p class="resource-desc"><%= r.description || '' %></p>
                            <p class="resource-meta-text"><%= r.module.nomModule %> — <%= r.module.codeModule %></p>
                            <p class="resource-meta-text"><i class="fas fa-user"></i> <%= r.professeur.nom %></p>
                            <div class="resource-card-meta">
                                <span class="badge" style="background:<%= r.couleurType %>"><%= r.type.nomType %></span>
                                <span class="resource-size"><%= r.tailleFormatee %></span>
                                <span class="resource-semestre"><%= r.module.semestre.nomSemestre %></span>
                            </div>
                        </div>
                        <div class="resource-card-actions">
                            <a href="/etudiant/ressource/voir?id=<%= r.idRessource %>"
                               class="btn-action btn-view" title="Voir"><i class="fas fa-eye"></i></a>
                            <a href="/etudiant/ressource/telecharger?id=<%= r.idRessource %>"
                               class="btn-action btn-download" title="T&eacute;l&eacute;charger"><i class="fas fa-download"></i></a>
                            <% if (r.estFavori) { %>
                                <a href="/etudiant/favori/retirer?id=<%= r.idRessource %>"
                                   class="btn-action btn-fav-active" title="Retirer des favoris"><i class="fas fa-star"></i></a>
                            <% } else { %>
                                <a href="/etudiant/favori/ajouter?id=<%= r.idRessource %>"
                                   class="btn-action btn-fav" title="Ajouter aux favoris"><i class="far fa-star"></i></a>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
                <% if (!ressources || ressources.length === 0) { %>
                    <p class="text-center text-muted" style="grid-column:1/-1;">Aucune ressource trouv&eacute;e</p>
                <% } %>
            </div>
        </div>
    </div>

    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/dashboard.js"></script>
</body>
</html>
